library(dplyr)
library(readxl)
library(sf)
library(ggplot2)
library(tidyr)
library(scales)
library(corrgram)
best1 = best
plot_map <- function(metric, dataset, type){
best <- read.csv(paste0("C:/Users/nan/OneDrive/Documentos/ucr/practica profesiona/dengue-model/data/model_results/metrics/best_model_", type, "_confint_", dataset, ".csv"))
if (metric == "nrmse"){
best$best_model = as.factor(best$best_nrmse_model)
}
if (metric == "mean"){
best$best_model = as.factor(best$best_mean_model)
}
else if (metric == "upper"){
best$best_model = as.factor(best$best_upper_model)
}
else if (metric == "lower"){
best$best_model = as.factor(best$best_lower_model)
}
levels(best$best_model) = c("HRF", "HXGB", "RF", "XGB")
best$canton[which(best$canton == "-202")] = 202
cantones <- st_read(r"(C:\Users\nan\OneDrive - Universidad de Costa Rica\cuenta personal\ucr pers\practica profesional\practica dengue\dengue-model\data\canton-shapes\UGEC_MGN_2022.shp)")
colnames(cantones)[which(colnames(cantones) == "COD_UGEC")] = "canton"
cantones$canton= as.numeric(cantones$canton)
cantones <- st_transform(cantones, 4326)
cant_best <- left_join(cantones, best, by = "canton") |>
filter(!canton %in% c(612, 613)) |>
select(c(canton, geometry, best_model))
ggplot(cant_best) +
geom_sf(aes(fill = best_model)) +
coord_sf(
xlim = c(-86, -82),
ylim = c(8,  11.4),
expand = FALSE
) +
scale_fill_discrete(name = paste0("Best Model")) +
labs(title = paste0("Best ", type, " model for ", dataset, " ", metric, " data points")) +
theme_void() +
theme(
plot.background = element_rect(fill = "white", color = NA),
panel.background = element_rect(fill = "white", color = NA),
panel.grid = element_blank(),
axis.line = element_blank(),
axis.ticks = element_blank(),
axis.text = element_blank(),
axis.title = element_blank(),
panel.border = element_blank(),
legend.position = "right"
)
ggsave(paste0("C:/Users/nan/OneDrive/Documentos/ucr/practica profesiona/dengue-model/data/model_results/best_model_per_canton_", metric ,"_" , type, "_", dataset, ".png"))
}
