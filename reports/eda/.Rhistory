}
canton_week <- function(df, var_name) {
df_pivot = pivot_longer(df, cols = -c("week"), names_to = "code", values_to = var_name)
df_pivot <- df_pivot |>
mutate(week_canton = paste(week, code, sep = "-")) |>
select(week_canton, var_name)
return(df_pivot)
}
baseLST <- read.csv("C:/Users/nan/OneDrive - Universidad de Costa Rica/cuenta personal/ucr pers/practica profesional/practica dengue/dengue-model/data/raw/baseLST.csv")
baseLST <- baseLST |>
mutate(fecha = ymd(fecha)) |>
select(lst, fecha, ID)
baseLST_wide <- pivot_wider(baseLST, names_from = ID, values_from =  lst)
baseLST_wide
baseLST_int <- interpolate(baseLST_wide, first_day = ymd("2020-01-01"), last_day = ymd("2025-12-31"))
baseLST_pivot <- canton_week(baseLST_int, var_name = "lst")
write.csv(baseLST_pivot, "C:/Users/nan/OneDrive - Universidad de Costa Rica/cuenta personal/ucr pers/practica profesional/practica dengue/dengue-model/data/clean/LST_int.csv")
View(baseLST)
